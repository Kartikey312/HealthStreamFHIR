# Database Configuration
# Remote corporate QA DB (works natively; blocked from Docker's network path):
DATABASE_URL=mysql+pymysql://medappqa:medappqa%402023@10.10.9.160:3306/medappqa
# Local MySQL, running in the Docker mysql-fhir container, exposed on localhost:3306:
# DATABASE_URL=mysql+pymysql://fhir_user:fhir_password@localhost:3306/fhir_db

# Kafka Configuration (Docker kafka container, exposed on localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MySQL Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=fhir_user
MYSQL_PASSWORD=fhir_password
MYSQL_DATABASE=fhir_db

# Service Ports
INTEGRATION_API_PORT=8000
COMMUNICATION_SERVICE_PORT=8001
KAFKA_UI_PORT=8080
MYSQL_PORT=3306

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
